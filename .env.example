# Kapcsolat-űrlap: SimplyForms form ID (publikus). Üresen az űrlap helyén "karbantartás alatt" üzenet.
SIMPLYFORMS_FORM_ID=

# Éles domain (metadataBase, canonical, OG, sitemap). Üresen: Vercel production URL, lokálban localhost.
NEXT_PUBLIC_SITE_URL=https://salesmaxhungary.hu

# CMS (Ügyfél Admin)
CMS_SITE_SLUG=salesmax
CMS_SUPABASE_URL=https://<project-ref>.supabase.co
CMS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# admin repo: npx tsx scripts/sync-manifest.mjs <repo>/cms.manifest.js --print-secret
CMS_REVALIDATE_SECRET=
# vesszővel elválasztva, pl. http://localhost:3000,https://admin.domain.hu
NEXT_PUBLIC_CMS_ADMIN_ORIGIN=
# 1 = CMS nélkül, csak manifest alapértékek (lokál fejlesztés)
CMS_OFFLINE=
